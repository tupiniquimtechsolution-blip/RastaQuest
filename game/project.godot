; Engine configuration file.
; Canonical Rasta Quest 1.0 bootstrap.
config_version=5

[application]
config/name="Rasta Quest"
config/version="1.0.0-rc.1"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]
RunManager="*res://scripts/roguelike/run_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
ArtCatalog="*res://scripts/art/visual_catalog.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input]

guard={
"deadzone": 0.2,
"events": []
}
move_left={
"deadzone": 0.5,
"events": []
}
move_right={
"deadzone": 0.5,
"events": []
}
jump={
"deadzone": 0.5,
"events": []
}
attack={
"deadzone": 0.5,
"events": []
}
pause={
"deadzone": 0.5,
"events": []
}
interact={
"deadzone": 0.5,
"events": []
}

[internationalization]
locale/translations=PackedStringArray("res://localization/strings.en.po", "res://localization/strings.pt_BR.po", "res://localization/strings.es.po")
locale/fallback="pt_BR"
